{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rj-master-sop-2026",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rj-sop-operations",
      "database_id": "62b785bb-c601-4271-b7a3-ad7efc7605ae"
    }
  ]
  // Secrets (set via `wrangler secret put` or .dev.vars for local):
  // MFSN_API_URL, MFSN_API_EMAIL, MFSN_API_PASSWORD
  // STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY
  // TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
  // SENDGRID_API_KEY, RESEND_API_KEY
  // OPENROUTER_API_KEY, GROQ_API_KEY
}
