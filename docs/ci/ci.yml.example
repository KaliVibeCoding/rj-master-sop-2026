name: CI

on:
  push:
    branches: [main, genspark_ai_developer]
  pull_request:
    branches: [main]

jobs:
  build-and-smoke:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      - name: Apply migrations to local D1
        run: |
          for f in migrations/*.sql; do
            npx wrangler d1 execute rj-sop-operations --local --file "$f" || true
          done

      - name: Start dev server
        run: |
          npx pm2 start ecosystem.config.cjs
          sleep 6

      - name: Smoke test
        run: bash scripts/smoke-test.sh

      - name: Stop dev server
        if: always()
        run: npx pm2 delete all || true
